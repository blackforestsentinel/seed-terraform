# Angelegt von seed-scaffold. Die eigentliche Pipeline liegt im Hub:
# github.com/blackforestsentinel/seed-pipelines
trigger:
  branches:
    include:
      - main

# PR-Läufe startet in Azure Repos die Branch-Policy auf main, nicht dieser Trigger.
pr: none

resources:
  repositories:
    - repository: seed
      type: github
      name: blackforestsentinel/seed-pipelines
      ref: refs/tags/${pipelines_version}
      endpoint: ${github_connection}

extends:
  template: templates/web-app.yml@seed
  parameters:
    project: ${name}
%{ if !frontend ~}
    # Ohne Frontend (project.yaml: hosting.staticWebApp: none)
    frontend: false
%{ endif ~}
    serviceConnection: ${service_connection}
    terraformState:
      resourceGroup: ${terraform_state.resource_group}
      storageAccount: ${terraform_state.storage_account}
      container: ${terraform_state.container}
    environments:
%{ for env in environments ~}
      - name: ${env}
%{ endfor ~}
