# Angelegt von seed-scaffold. Die eigentliche Pipeline liegt im Hub:
# github.com/blackforestsentinel/seed-pipelines
trigger:
  branches:
    include:
      - main

# PR-Läufe startet in Azure Repos die Branch-Policy auf main, nicht dieser Trigger.
pr: none

# Nur von Hand ankreuzen, jeweils für einen bewusst gestarteten Lauf:
parameters:
  # Erlaubt einem Lauf, Daten zu löschen (Storage, Key Vault, Logs). Ohne Bestätigung endet ein
  # Plan, der solche Ressourcen löscht oder ersetzt, vor der Freigabe.
  - name: confirmDataDeletion
    displayName: Datenlöschung bestätigen (Storage, Key Vault, Logs)
    type: boolean
    default: false
%{ if pipelines_v017 ~}
  # Nur mit features.customConnector: Entfernt der Lauf eine Operation des Custom Connectors oder
  # ändert sie so, dass Flows brechen, die sie nutzen, endet er sonst vor dem Deploy. Angekreuzt
  # werden die Fehler zu Warnungen, etwa wenn der betroffene Flow ohnehin abgeschaltet wird.
  - name: allowBreakingConnectorChanges
    displayName: Breaking Changes am Custom Connector zulassen
    type: boolean
    default: false
%{ endif ~}

resources:
  repositories:
    # Der Name seed ist fest: Die Pipeline liest darüber ihre eigenen Skripte und Versionen.
    - repository: seed
      type: github
      name: blackforestsentinel/seed-pipelines
      ref: refs/tags/${pipelines_version}
      # GitHub-Service-Connection der Azure-DevOps-Organisation (nur Lesezugriff nötig)
      endpoint: ${github_connection}

extends:
  template: templates/web-app.yml@seed
  parameters:
    project: ${name}
%{ if !frontend ~}
    # Ohne Frontend (project.yaml: hosting.staticWebApp: none)
    frontend: false
%{ endif ~}
    serviceConnection: ${service_connection}
%{ if pool != "" ~}
    # Eigener Agent-Pool statt Microsoft-gehosteter Agents
    pool: ${pool}
%{ endif ~}
    # Ablage des Terraform-States im Tenant, angelegt beim Tenant-Onboarding
    terraformState:
      resourceGroup: ${terraform_state.resource_group}
      storageAccount: ${terraform_state.storage_account}
      container: ${terraform_state.container}
    confirmDataDeletion: $${{ parameters.confirmDataDeletion }}
%{ if pipelines_v017 ~}
    # Warnungen von Compiler, Analyzern und MSBuild brechen den Build (Standard). Abschalten nur
    # vorübergehend und mit Begründung im PR:
    # treatWarningsAsErrors: false
    allowBreakingConnectorChanges: $${{ parameters.allowBreakingConnectorChanges }}
    # Nur mit features.customConnector, Opt-in: prüft, ob die Konten der Verbindungen zum Connector
    # eine Rolle aus auth.roles haben, und warnt sonst. Die Pipeline-Identität braucht dafür
    # zusätzliche Rechte (README von seed-pipelines).
    # checkConnectorConnections: true
%{ endif ~}
    # Mit sso muss GET /api/me ohne Token mit 401 antworten.
    smokeTest:
      protectedPath: api/me
    environments:
%{ for env in environments ~}
      - name: ${env}
%{ endfor ~}
